{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>victron-venus/venus-os-ci-toolkit:renovate-fleet"
  ],
  "enabledManagers": [
    "custom.jsonata",
    "custom.regex",
    "docker-compose",
    "dockerfile",
    "github-actions",
    "pep621",
    "pip-compile",
    "pip_requirements"
  ],
  "lockFileMaintenance": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^Dockerfile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=docker depName=python currentValue=(?<currentValue>[^\\s]+)\\s+FROM (?<depName>python)@(?<currentDigest>sha256:[a-f0-9]{64})",
        "# renovate: datasource=docker depName=ghcr.io/astral-sh/uv currentValue=(?<currentValue>[^\\s]+)\\s+FROM (?<depName>ghcr.io/astral-sh/uv)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ],
  "ignorePaths": [
    "**/vendor/**",
    "**/node_modules/**",
    "**/fixtures/**",
    "**/tools/browser-compatibility/**",
    "security/provider/**",
    "build-support/tls-armv7/**"
  ],
  "packageRules": [
    {
      "description": "Keep the reviewed post-v0.36.0 commit: the v0.36.0 tag downgrades Trivy 0.74 to 0.70. New tagged releases remain eligible.",
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "aquasecurity/trivy-action"
      ],
      "matchCurrentValue": "v0.36.0",
      "matchUpdateTypes": [
        "digest"
      ],
      "enabled": false
    },
    {
      "matchManagers": [
        "pep621"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "Python dependencies"
    },
    {
      "matchManagers": [
        "dockerfile"
      ],
      "pinDigests": true
    },
    {
      "description": "Python and uv tag annotations and immutable digests are updated together by the regex manager.",
      "matchManagers": [
        "dockerfile"
      ],
      "matchPackageNames": [
        "python",
        "ghcr.io/astral-sh/uv"
      ],
      "enabled": false
    },
    {
      "matchManagers": [
        "custom.regex"
      ],
      "matchPackageNames": [
        "python"
      ],
      "pinDigests": true
    }
  ],
  "pip_requirements": {
    "managerFilePatterns": [
      "/(^|/)requirements[^/]*\\.(txt|pip)$/"
    ],
    "ignorePaths": [
      "**/vendor/**",
      "**/node_modules/**",
      "**/fixtures/**",
      "**/tools/browser-compatibility/**",
      "security/provider/**",
      "build-support/tls-armv7/**",
      ".github/requirements-fuzz.txt"
    ]
  },
  "description": [
    "Container annotations and digests must be updated together by the reviewed custom manager.",
    "GitHub vulnerability alerts and normal scheduled updates remain enabled; automatic security overrides must not bypass these constraints."
  ],
  "pip-compile": {
    "managerFilePatterns": [
      "/^\\.github/requirements\\-fuzz\\.txt$/"
    ]
  }
}
